@model PersonnelResponse

@{
	ViewData["Title"] = "Personel Sil";
}

<div class="content-panel form-panel">
	<h1 class="mb-4">Personel Sil</h1>

	<p class="text-muted">Bu personel kaydı kalıcı olarak silinecek. Devam etmek istediğinize emin misiniz?</p>

	<p>
		<strong>Ad Soyad:</strong>
		@Model.FirstName @Model.LastName
	</p>

	<div asp-validation-summary="ModelOnly" class="text-danger"></div>

	<form asp-controller="Personnel" asp-action="Delete" method="post">
		<input asp-for="Id" type="hidden" />

		<button type="submit" class="btn btn-danger">Sil</button>

		<a asp-controller="Personnel" asp-action="Index" class="btn btn-outline-secondary">
			Vazgeç
		</a>
	</form>
</div>
