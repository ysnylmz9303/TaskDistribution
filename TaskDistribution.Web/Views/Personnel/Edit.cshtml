@model PersonnelUpdateRequest

@{
	ViewData["Title"] = "Personel Düzenle";
}

<div class="content-panel form-panel">
	<h1 class="mb-4">Personel Düzenle</h1>

	<form asp-controller="Personnel" asp-action="Edit" method="post">
		<div asp-validation-summary="All" class="text-danger mb-3"></div>
		<input asp-for="Id" type="hidden" />

		<div class="mb-3">
			<label asp-for="FirstName" class="form-label">Ad</label>
			<input asp-for="FirstName" class="form-control" />
		</div>

		<div class="mb-3">
			<label asp-for="LastName" class="form-label">Soyad</label>
			<input asp-for="LastName" class="form-control" />
		</div>

		<div class="form-check mb-3">
			<input asp-for="IsActive" class="form-check-input" />
			<label asp-for="IsActive" class="form-check-label">Aktif</label>
		</div>

		<button type="submit" class="btn btn-primary">Güncelle</button>

		<a asp-controller="Personnel" asp-action="Index" class="btn btn-outline-secondary">
			Listeye Dön
		</a>
	</form>
</div>
