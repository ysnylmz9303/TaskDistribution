@model IReadOnlyList<PersonnelResponse>

@{
	ViewData["Title"] = "Personel Listesi";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
	<div>
		<h1>Personel Listesi</h1>
		<p class="text-muted mb-0">Ekibinizdeki personelleri görüntüleyin ve yönetin.</p>
	</div>

	<a asp-controller="Personnel" asp-action="Create" class="btn btn-primary">
		Personel Ekle
	</a>

</div>

<div class="content-panel">
	<p class="text-muted">Toplam @Model.Count personel</p>
	<div class="table-responsive">
		<table class="table table-hover mb-0">
			<thead>
				<tr>
					<th>Ad</th>
					<th>Soyad</th>
					<th>Durum</th>
					<th>İşlemler</th>
				</tr>
			</thead>
			<tbody>
				@if (Model.Count == 0)
				{
					<tr>
						<td colspan="4" class="text-center text-muted py-5">Henüz personel eklenmemiş. Personel Ekle butonuyla başlayabilirsiniz.</td>
					</tr>
				}
				@foreach (var personnel in Model)
				{
					<tr>
						<td>@personnel.FirstName</td>
						<td>@personnel.LastName</td>
						<td>
							@if (personnel.IsActive)
							{
								<span class="status-active">Aktif</span>
							}
							else
							{
								<span class="status-inactive">Pasif</span>
							}
							<form asp-controller="Personnel" asp-action="UpdateStatus" method="post" class="mt-2">
								<input type="hidden" name="id" value="@personnel.Id" />
								<div class="form-check form-switch">
									<input type="checkbox" name="isActive" value="true"
										   id="status-@personnel.Id" class="form-check-input" role="switch"
										   checked="@personnel.IsActive" onchange="this.form.requestSubmit()" />
									<label for="status-@personnel.Id" class="visually-hidden">
										@personnel.FirstName @personnel.LastName aktiflik durumu
									</label>
								</div>
								<input type="hidden" name="isActive" value="false" />
							</form>
						</td>
						<td class="text-nowrap">
							<a asp-controller="Personnel"
							   asp-action="Edit"
							   asp-route-id="@personnel.Id"
							   class="btn btn-outline-primary btn-sm">
								Düzenle
							</a>
							<a asp-controller="Personnel"
							   asp-action="Delete"
							   asp-route-id="@personnel.Id"
							   class="btn btn-outline-danger btn-sm">
								Sil
							</a>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
</div>
